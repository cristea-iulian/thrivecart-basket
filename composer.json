{
  "name": "iulian/thrivecart-basket",
  "description": "Acme Widget basket coding exercise",
  "type": "project",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
